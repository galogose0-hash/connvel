# Kunci admin dashboard Connvel (wajib diisi di Vercel Project Settings -> Environment Variables).
CONNVEL_ADMIN_TOKEN=

# Diset otomatis oleh Vercel saat Vercel Blob store dihubungkan ke project.
# Untuk pengembangan lokal, isi dari dashboard Vercel Blob atau hasil `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
