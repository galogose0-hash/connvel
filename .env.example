# Kunci admin dashboard Connvel (wajib diisi di Vercel Project Settings -> Environment Variables).
CONNVEL_ADMIN_TOKEN=

# Vercel Blob memakai OIDC secara default: saat Blob store dihubungkan ke project,
# Vercel menyuntikkan VERCEL_OIDC_TOKEN dan BLOB_STORE_ID secara otomatis.
# BLOB_READ_WRITE_TOKEN hanya perlu jika koneksi store memilih opsi read-write token.
# Untuk pengembangan lokal, jalankan `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
